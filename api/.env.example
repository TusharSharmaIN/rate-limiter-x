# Redis
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
# API
GRPC_PORT=50051
HTTP_PORT=3000
# Algorithm
RATE_LIMIT_STRATEGY=leaky_bucket   # token_bucket | fixed_window | sliding_window_log | sliding_window_counter | leaky_bucket
RATE_LIMIT_CAPACITY=10             # shared across all algorithms
# Config
RATE_LIMIT_REFILL_PER_SEC=1        # token_bucket only
RATE_LIMIT_WINDOW_SIZE_SEC=60      # fixed_window / sliding_window_log / sliding_window_counter only
RATE_LIMIT_LEAK_RATE_PER_SEC=1     # leaky_bucket only
# Log
LOG_LEVEL=debug                    # debug | log | warn | error
NODE_ENV=development
REDIS_RETRY_MAX_DELAY_MS=2000      # cap on reconnect backoff
FAIL_OPEN_ENABLED=true            # false = deny all when Redis is down